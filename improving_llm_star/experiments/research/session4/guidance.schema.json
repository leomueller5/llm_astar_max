{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Strategic Grid Guidance v1",
 "type":"object","required":["version"],"properties":{
  "version":{"const":1},"abstain":{"type":"boolean"},
  "strategies":{"type":"array","maxItems":4,"items":{
   "type":"object","required":["id"],"properties":{
    "id":{"type":"string","minLength":1,"maxLength":64},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "waypoints":{"type":"array","maxItems":256,"items":{"type":"array","prefixItems":[{"type":"integer"},{"type":"integer"}],"minItems":2,"maxItems":2}},
    "regions":{"type":"array","maxItems":2048,"items":{"type":"string","minLength":1,"maxLength":64}},
    "bypasses":{"type":"array","maxItems":256,"items":{"type":"object","required":["obstacle_id","side"],"properties":{"obstacle_id":{"type":"string","pattern":"^[hv][0-9]+$"},"side":{"enum":["left","right","above","below"]}}}}
   }
  }}
 }
}
